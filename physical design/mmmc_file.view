create_library_set \
-name TYPICAL_LIB \
-timing {/"<liberty_file_path (slow / typical / fast)>"}

create_timing_condition \
-name TYPICAL_CONDITION \
-library_sets {TYPICAL_LIB}

create_rc_corner \
-name TYPICAL_RC

create_delay_corner \
-name TYPICAL_DELAY \
-timing_condition TYPICAL_CONDITION \
-rc_corner TYPICAL_RC

create_constraint_mode \
-name CONSTRAINTS \
-sdc_files {/"<sdc_out_file>"}

create_analysis_view \
-name SETUP_VIEW \
-constraint_mode CONSTRAINTS \
-delay_corner TYPICAL_DELAY

create_analysis_view \
-name HOLD_VIEW \
-constraint_mode CONSTRAINTS \
-delay_corner TYPICAL_DELAY

set_analysis_view \
-setup {SETUP_VIEW} \
-hold {HOLD_VIEW}